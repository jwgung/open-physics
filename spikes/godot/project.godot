; Engine configuration file.
config_version=5

[application]

config/name="Open Physics 3D Spike (Godot)"
config/description="Phase 0 spike B: Godot 4.7 + Jolt benchmark scenes S1-S3"
run/main_scene="res://scenes/main.tscn"
run/delta_smoothing=false
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Bench="*res://scripts/bench.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-OpenPhysicsSubset.otf"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
