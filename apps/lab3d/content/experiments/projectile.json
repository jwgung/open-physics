{
  "id": "projectile",
  "version": 1,
  "content": "projectile",
  "scene": "res://experiments/projectile/projectile.gd",
  "bench_id": "PJ",
  "camera": {
    "target": [-0.8, 1.8, 0.0],
    "distance": 12.5,
    "distance_range": [3.0, 26.0],
    "yaw_range_deg": [-100.0, 100.0],
    "pitch_range_deg": [-89.0, -2.0],
    "pan_radius": 7.0,
    "default_mode": "three_quarter",
    "views": {
      "front": { "yaw_deg": 0.0, "pitch_deg": -4.0, "distance": 13.5 },
      "three_quarter": { "yaw_deg": 25.0, "pitch_deg": -18.0 },
      "top": { "yaw_deg": 0.0, "pitch_deg": -89.0, "distance": 15.0 },
      "side": { "yaw_deg": 90.0, "pitch_deg": -8.0, "distance": 15.0 },
      "follow": { "yaw_deg": 20.0, "pitch_deg": -14.0, "distance": 6.0 }
    }
  },
  "controls": [
    {
      "id": "gravity", "type": "choice", "label": "중력", "default": "earth",
      "options": [
        { "id": "zero", "label": "무중력", "g": 0.0, "note": "무중력 · 0× · g = 0 m/s²" },
        { "id": "moon", "label": "달", "g": 1.62, "note": "달 · 0.17× · g = 1.62 m/s²" },
        { "id": "earth", "label": "지구", "g": 9.81, "note": "지구 · 1× · g = 9.81 m/s²" },
        { "id": "jupiter", "label": "목성", "g": 24.79, "note": "목성 · 2.53× · g = 24.79 m/s²" }
      ]
    },
    {
      "id": "angle", "type": "slider", "label": "던지는 각도", "unit": "°",
      "min": 0.0, "max": 90.0, "step": 15.0, "default": 45.0, "digits": 0
    },
    {
      "id": "speed", "type": "slider", "label": "던지는 빠르기 v₀", "unit": " m/s",
      "min": 1.0, "max": 9.0, "step": 0.5, "default": 9.0, "digits": 1
    }
  ],
  "actions": [
    { "id": "release", "label": "공 놓기", "style": "primary" },
    { "id": "reset", "label": "처음으로" }
  ],
  "observations": [
    { "id": "g", "label": "중력 가속도 g", "unit": "m/s²", "digits": 2 },
    { "id": "time", "label": "던진 뒤 시간 t", "unit": "s", "digits": 2 },
    { "id": "state", "label": "공 상태" },
    { "id": "launch_height", "label": "던지는 높이 h₀", "unit": "m", "digits": 2 },
    { "id": "range", "label": "날아가는 거리 R (공식)", "unit": "m", "digits": 2 },
    { "id": "flight_time", "label": "비행 시간 T (공식)", "unit": "s", "digits": 2 },
    { "id": "apex", "label": "최고점 높이 H (공식)", "unit": "m", "digits": 2 },
    { "id": "x", "label": "옆으로 간 거리 x", "unit": "m", "digits": 2 },
    { "id": "y", "label": "높이 y", "unit": "m", "digits": 2 },
    { "id": "vx", "label": "옆 방향 속도", "unit": "m/s", "digits": 2 },
    { "id": "vy", "label": "위아래 속도 (위 +)", "unit": "m/s", "digits": 2 },
    { "id": "landing", "label": "착지 거리 (시뮬레이션)", "unit": "m", "digits": 2 }
  ],
  "graph": {
    "title": "발사체의 높이",
    "x": { "label": "시간 t", "unit": "s", "max": 3.0 },
    "y": { "label": "높이 y", "unit": "m", "min_max": 2.0 },
    "series": [
      { "id": "formula", "label": "공식 y(t)", "color": "#2d7cf6", "style": "line" },
      { "id": "measured", "label": "시뮬레이션", "color": "#ff3b3b", "style": "points" }
    ]
  },
  "manipulation": {
    "objects": [
      { "id": "ball", "surface": "launch", "snap": 0.5, "height": { "max": 3.0, "step": 0.25 } },
      { "id": "arrow", "surface": "arrow", "snap": 0.0, "height": false }
    ],
    "demo_action": "release"
  }
}
