## Headless tests for the 3D app.
## Run: apps/lab3d/tools/build.sh test
##   (= godot --headless --path apps/lab3d --fixed-fps 60 -s res://tests/run_tests.gd)
## 1. parity: GDScript PhysicsLaws vs TS-core vectors (tests/incline_vectors.json, generated by
##    tools/incline-vectors.test.ts) for the spec S3 pair and the four surface materials.
## 2. incline formula match: the app's experiment (Jolt + formula correction) reproduces the
##    benchmark spec section 4 table and holds/slides at each material's critical angle.
## 3. shell: content registry, font coverage, camera modes/limits, gesture classification,
##    portrait/landscape layout.
## Times are engine fixed steps (60 Hz), independent of rendering FPS.
extends SceneTree

const VECTORS_PATH := "res://tests/incline_vectors.json"
## Scripts that use the Quality/Bench autoloads are loaded at runtime: with `-s` the autoload names
## do not exist yet when this file is compiled.
const VIEW_3D := "res://scripts/shell/view_3d.gd"
const EXPERIMENT_SCREEN := "res://scripts/shell/experiment_screen.gd"
const UI_THEME := "res://scripts/app/ui_theme.gd"
const STEP_HZ := 60

var _failures := 0
var _lab: Experiment
var _vectors: Dictionary


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	_vectors = JSON.parse_string(FileAccess.get_file_as_string(VECTORS_PATH))
	print("== parity: GDScript PhysicsLaws vs TS core vectors ==")
	_check_parity()
	print("== content and fonts ==")
	var definition := _check_content()
	_check_fonts()
	print("== incline formula match (Jolt + correction layer, %d Hz fixed step) ==" % STEP_HZ)
	_lab = ExperimentRegistry.instantiate(definition)
	root.add_child(_lab)
	await process_frame
	await _check_spec_table()
	await _check_materials(definition)
	_lab.queue_free()
	print("== shell: camera, gestures, layout ==")
	await _check_camera(definition)
	await _check_gestures(definition)
	await _check_layout(definition)
	print("RESULT: %s (%d failure(s))" % ["PASS" if _failures == 0 else "FAIL", _failures])
	quit(1 if _failures > 0 else 0)


func _expect(ok: bool, label: String, detail: String) -> void:
	print("%s  %s  %s" % ["PASS" if ok else "FAIL", label, detail])
	if not ok:
		_failures += 1


func _within(value: float, expected: float, rel: float) -> bool:
	return absf(value - expected) <= absf(expected) * rel


# --- 1. parity --------------------------------------------------------------------------------

func _check_parity() -> void:
	var g: float = _vectors.g
	var mass: float = _vectors.mass
	var dt: float = _vectors.dt
	for set in _vectors.sets:
		var mu_s: float = set.mu_s
		var mu_k: float = set.mu_k
		var worst := 0.0
		for case in set.cases:
			var theta := deg_to_rad(case.theta_deg)
			var force := PhysicsLaws.corrected_tangential_force(
				PhysicsLaws.incline_tangential_gravity(mass, g, theta), case.speed,
				PhysicsLaws.incline_normal_load(mass, g, theta), mu_s, mu_k, mass, dt)
			worst = maxf(worst, absf(force / mass - float(case.tangential_accel)))
		_expect(worst < 1e-9, "%s friction modifier parity" % set.id, "%d cases, max |diff| = %s m/s^2" % [set.cases.size(), str(worst)])
		var critical := rad_to_deg(PhysicsLaws.critical_angle(mu_s))
		var a35 := PhysicsLaws.incline_acceleration(g, deg_to_rad(35.0), mu_s, mu_k)
		var a40 := PhysicsLaws.incline_acceleration(g, deg_to_rad(40.0), mu_s, mu_k)
		_expect(absf(critical - float(set.critical_angle_deg)) < 1e-9 and absf(a35 - float(set.accel_35)) < 1e-9 \
			and absf(a40 - float(set.accel_40)) < 1e-9, "%s critical angle, a(35deg), a(40deg)" % set.id,
			"%.3f deg, %.4f, %.4f m/s^2" % [critical, a35, a40])
		var worst_s := 0.0
		for row in set.displacement_40:
			worst_s = maxf(worst_s, absf(PhysicsLaws.constant_acceleration_displacement(0.0, a40, row.t) - float(row.s)))
		_expect(worst_s < 1e-9, "%s s(t) at 40deg" % set.id, "max |diff| = %s m" % str(worst_s))


# --- 2. incline formula match -------------------------------------------------------------------

func _run_steps(angle: float, steps: int) -> InclineFrictionCorrector:
	_lab.set_angle(angle)
	await physics_frame
	_lab.release()
	while _lab.corrector.steps <= steps:
		await physics_frame
	return _lab.corrector


## Benchmark spec section 4 with its fixed pair mu_s 0.5 / mu_k 0.4 (same table as spike S3).
func _check_spec_table() -> void:
	_lab.set_coefficients(0.5, 0.4)
	var c := await _run_steps(26.0, 3 * STEP_HZ)
	_expect(c.max_offset <= 0.001 and c.status == "holding", "spec 26.0deg holds (3 s)",
		"max displacement %.6f mm, status %s" % [c.max_offset * 1000.0, c.status])
	c = await _run_steps(27.0, STEP_HZ)
	var start := _first_move_step(c)
	_expect(start >= 0 and start <= STEP_HZ, "spec 27.0deg slides within 1 s", "moved >1 mm at step %d" % start)
	c = await _run_steps(35.0, 2 * STEP_HZ)
	var s1 := c.samples[STEP_HZ]
	var s2 := c.samples[2 * STEP_HZ]
	var a_measured := 2.0 * s2 / 4.0
	var a_velocity := c.velocities[2 * STEP_HZ] - c.velocities[STEP_HZ]
	_expect(_within(a_measured, 2.412, 0.01) and _within(a_velocity, 2.412, 0.01), "spec a(35deg) measured ±1%",
		"2s/t^2 %.4f, dv/dt %.4f m/s^2 vs 2.412" % [a_measured, a_velocity])
	_expect(_within(s1, 1.206, 0.01) and _within(s2, 4.825, 0.01), "spec s(1s), s(2s) at 35deg ±1%",
		"%.4f m / %.4f m vs 1.206 / 4.825" % [s1, s2])
	var shown: float = _lab.observations().acceleration
	_expect(absf(shown - 2.412) < 0.0005, "spec a(35deg) displayed = formula", "%.4f m/s^2" % shown)
	c = await _run_steps(20.0, 10 * STEP_HZ)
	_expect(c.max_offset <= 0.001, "spec 20.0deg drift over 10 s", "%.6f mm" % (c.max_offset * 1000.0))


## Each surface material from the content JSON: holds 0.5 deg below its critical angle, slides
## within 1 s 0.5 deg above, and follows s = a t^2 / 2 at 40 deg (1 s and 1.5 s: on steel the box
## runs off the 7.5 m incline before 2 s).
func _check_materials(definition: Dictionary) -> void:
	var control: Dictionary = {}
	for candidate in definition.controls:
		if candidate.id == "material":
			control = candidate
	for option in control.options:
		_lab.set_material(option.id)
		var critical := rad_to_deg(PhysicsLaws.critical_angle(option.mu_s))
		var c := await _run_steps(critical - 0.5, 2 * STEP_HZ)
		_expect(c.max_offset <= 0.001 and c.status == "holding", "%s holds at %.1fdeg (critical %.2f)" % [option.id, critical - 0.5, critical],
			"max displacement %.6f mm" % (c.max_offset * 1000.0))
		c = await _run_steps(critical + 0.5, STEP_HZ)
		var start := _first_move_step(c)
		_expect(start >= 0 and start <= STEP_HZ, "%s slides at %.1fdeg within 1 s" % [option.id, critical + 0.5], "moved >1 mm at step %d" % start)
		c = await _run_steps(40.0, 3 * STEP_HZ / 2)
		var a := PhysicsLaws.incline_acceleration(9.81, deg_to_rad(40.0), option.mu_s, option.mu_k)
		var s1 := c.samples[STEP_HZ]
		var s15 := c.samples[3 * STEP_HZ / 2]
		_expect(_within(s1, 0.5 * a, 0.01) and _within(s15, 1.125 * a, 0.01), "%s s(1s), s(1.5s) at 40deg ±1%%" % option.id,
			"%.4f / %.4f m vs %.4f / %.4f" % [s1, s15, 0.5 * a, 1.125 * a])
		var graph: Dictionary = _lab.graph_series()
		var measured: PackedVector2Array = graph.measured
		var last := measured[-1] if measured.size() > 0 else Vector2.ZERO
		_expect(measured.size() >= 10 and _within(last.y, 0.5 * a * last.x * last.x, 0.01), "%s graph samples follow the formula" % option.id,
			"%d points, last (%.2f s, %.4f m)" % [measured.size(), last.x, last.y])


func _first_move_step(c: InclineFrictionCorrector) -> int:
	for k in c.samples.size():
		if c.samples[k] > 0.001:
			return k
	return -1


# --- 3. shell ---------------------------------------------------------------------------------

func _check_content() -> Dictionary:
	var all := ExperimentRegistry.load_all()
	_expect(all.size() >= 1, "registry loads experiments", "%d" % all.size())
	var definition := ExperimentRegistry.find("incline-friction")
	_expect(not definition.is_empty() and ExperimentRegistry.validate(definition).is_empty(), "incline-friction definition valid",
		", ".join(ExperimentRegistry.validate(definition)) if not definition.is_empty() else "missing")
	var broken := definition.duplicate(true)
	broken.camera.default_mode = "sideways"
	broken.controls[0].erase("default")
	_expect(ExperimentRegistry.validate(broken).size() >= 2, "registry rejects an invalid definition", ", ".join(ExperimentRegistry.validate(broken)))
	# Content materials must equal the TS-derived coefficient sets (vitest checks JSON vs TS too).
	var ok := true
	for control in definition.controls:
		if control.id != "material":
			continue
		for option in control.options:
			for set in _vectors.sets:
				if set.id == option.id:
					ok = ok and absf(float(set.mu_s) - float(option.mu_s)) < 1e-9 and absf(float(set.mu_k) - float(option.mu_k)) < 1e-9
	_expect(ok, "content materials = TS MATERIALS", "")
	return definition


func _check_fonts() -> void:
	var theme_script: Script = load(UI_THEME)
	var regular: Font = load(theme_script.FONT_REGULAR)
	var bold: Font = load(theme_script.FONT_BOLD)
	var missing := ""
	for path in _text_files("res://scripts") + _text_files("res://experiments") + _text_files("res://content"):
		for c in FileAccess.get_file_as_string(path):
			var code := c.unicode_at(0)
			if code > 126 and code != 0xFEFF and (not regular.has_char(code) or not bold.has_char(code)) and c not in missing:
				missing += c
	_expect(missing == "", "UI fonts cover every used character", "missing: %s (run tools/subset_font.sh)" % missing if missing != "" else "")


func _text_files(dir: String) -> PackedStringArray:
	var result := PackedStringArray()
	for file in DirAccess.get_files_at(dir):
		if file.ends_with(".gd") or file.ends_with(".json"):
			result.append(dir.path_join(file))
	for sub in DirAccess.get_directories_at(dir):
		result.append_array(_text_files(dir.path_join(sub)))
	return result


func _check_camera(definition: Dictionary) -> void:
	var holder := Node3D.new()
	root.add_child(holder)
	var rig := CameraRig.new()
	holder.add_child(rig)
	var target := Node3D.new()
	target.set_script(load("res://tests/follow_probe.gd"))
	holder.add_child(target)
	rig.follow_source = target
	rig.configure(definition.camera)
	_expect(rig.mode == definition.camera.default_mode, "camera starts in the experiment's default mode", rig.mode)
	var views: Dictionary = definition.camera.views
	var ok := true
	for mode in ["front", "three_quarter", "top", "side"]:
		rig.set_mode(mode)
		_step(rig, 1.0)
		var view: Dictionary = views[mode]
		ok = ok and rig.is_settled() and absf(rad_to_deg(rig.cur_yaw) - float(view.yaw_deg)) < 0.1 \
			and absf(rad_to_deg(rig.cur_pitch) - float(view.pitch_deg)) < 0.1
	_expect(ok, "preset modes ease to their views within 1 s", "front, 3/4, top, side")
	rig.set_mode("front")
	_step(rig, 0.1)
	_expect(not rig.is_settled() and rig.cur_yaw > 0.0, "mode change is a smooth transition (not a jump)", "yaw after 0.1 s %.1f deg" % rad_to_deg(rig.cur_yaw))
	rig.orbit(Vector2(-100000, 100000))
	var limits_ok := rig.mode == "orbit" and rig.goal_yaw <= deg_to_rad(definition.camera.yaw_range_deg[1]) + 1e-6 \
		and rig.goal_pitch >= deg_to_rad(definition.camera.pitch_range_deg[0]) - 1e-6
	_expect(limits_ok, "turning switches to 제한 회전 and stays inside the limits",
		"yaw %.1f, pitch %.1f deg" % [rad_to_deg(rig.goal_yaw), rad_to_deg(rig.goal_pitch)])
	rig.zoom(0.0001)
	_expect(is_equal_approx(rig.goal_distance, definition.camera.distance_range[0]), "zoom clamps to the distance range", "%.2f" % rig.goal_distance)
	rig.pan_by(Vector2(100000, 0))
	_expect(rig.pan.length() <= definition.camera.pan_radius + 1e-4, "pan stays inside pan_radius", "%.2f" % rig.pan.length())
	rig.set_mode("front")
	_expect(rig.pan == Vector3.ZERO and is_equal_approx(rig.goal_distance, definition.camera.distance), "정면으로 resets pan and zoom", "")
	rig.set_mode("follow")
	target.position = Vector3(3, 1, 0)
	_step(rig, 1.5)
	_expect(rig.cur_target.distance_to(Vector3(3, 1, 0)) < 0.01, "follow mode tracks the experiment's follow point", str(rig.cur_target))
	holder.queue_free()


func _step(rig: CameraRig, seconds: float) -> void:
	for i in int(seconds * 60.0):
		rig._process(1.0 / 60.0)


func _check_gestures(definition: Dictionary) -> void:
	var view: Control = load(VIEW_3D).new()
	view.size = Vector2(720, 600)
	root.add_child(view)
	view.rig.configure(definition.camera)
	var pointer_events: Array[String] = []
	view.single_pointer.connect(func(kind: String, _p: Vector2) -> void: pointer_events.append(kind))
	# One finger dragging on the empty view: no camera change, reported for manipulation (2b).
	var yaw: float = view.rig.goal_yaw
	var distance: float = view.rig.goal_distance
	_touch(view, 0, Vector2(300, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 + i * 20, 300))
	_touch(view, 0, Vector2(500, 300), false)
	_expect(view.rig.goal_yaw == yaw and view.rig.goal_distance == distance and pointer_events.has("move"),
		"one finger does not turn the camera", "events %s" % ",".join(pointer_events))
	# Two fingers moving together: orbit.
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(400, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 + i * 10, 300))
		_drag(view, 1, Vector2(400 + i * 10, 300))
	_expect(view.rig.goal_yaw != yaw and view.rig.mode == "orbit" and is_equal_approx(view.rig.goal_distance, distance),
		"two-finger drag turns the view (제한 회전)", "yaw %.1f -> %.1f deg" % [rad_to_deg(yaw), rad_to_deg(view.rig.goal_yaw)])
	# Lifting one finger ends the gesture; the remaining finger does not become a drag.
	pointer_events.clear()
	_touch(view, 1, Vector2(490, 300), false)
	var yaw_after: float = view.rig.goal_yaw
	for i in 5:
		_drag(view, 0, Vector2(390 + i * 20, 300))
	_touch(view, 0, Vector2(470, 300), false)
	_expect(view.rig.goal_yaw == yaw_after and not pointer_events.has("move") and not pointer_events.has("release"),
		"the finger left after a two-finger gesture is ignored", "events %s" % ",".join(pointer_events))
	# Two fingers spreading: zoom in (and pan with the midpoint).
	distance = view.rig.goal_distance
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(400, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 - i * 10, 300))
		_drag(view, 1, Vector2(400 + i * 10, 300))
	_expect(view.rig.goal_distance < distance * 0.7, "pinch-out zooms in", "distance %.2f -> %.2f" % [distance, view.rig.goal_distance])
	_touch(view, 1, Vector2(490, 300), false)
	_touch(view, 0, Vector2(210, 300), false)
	# Two fingers close together, moving together after a small pinch: pan.
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(340, 300), true)
	_drag(view, 1, Vector2(360, 300))  # spread first -> pinch gesture
	var pan_before: Vector3 = view.rig.pan
	for i in 10:
		_drag(view, 0, Vector2(300, 300 + i * 10))
		_drag(view, 1, Vector2(360, 300 + i * 10))
	_expect(view.rig.pan.distance_to(pan_before) > 0.05, "pinch gesture moves (pans) the view", "pan %s" % str(view.rig.pan))
	view.queue_free()


func _touch(view: Control, index: int, position: Vector2, pressed: bool) -> void:
	var event := InputEventScreenTouch.new()
	event.index = index
	event.position = position
	event.pressed = pressed
	view._gui_input(event)


func _drag(view: Control, index: int, position: Vector2) -> void:
	var event := InputEventScreenDrag.new()
	event.index = index
	event.position = position
	view._gui_input(event)


func _check_layout(definition: Dictionary) -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	root.add_child(host)
	for size: Vector2 in [Vector2(720, 1560), Vector2(1152, 720)]:
		host.size = size
		var screen: Control = load(EXPERIMENT_SCREEN).new()
		screen.setup(definition)
		host.add_child(screen)
		await process_frame
		await process_frame
		var panel: Control = screen._panel
		var landscape := size.x > size.y
		var placed: bool = panel.position.x > screen.view.position.x if landscape else panel.position.y > screen.view.position.y
		var acceleration: Label = screen._observation_labels["acceleration"]
		_expect(placed and screen.view.size.x > 300 and acceleration.text.ends_with("m/s²"),
			"%s layout: view %s, panel at %s, observations filled" % ["landscape" if landscape else "portrait", screen.view.size, panel.position],
			acceleration.text)
		screen.queue_free()
		await process_frame
	host.queue_free()
