{
  "id": "rotation",
  "version": 1,
  "content": "rotation",
  "scene": "res://experiments/rotation/rotation.gd",
  "bench_id": "RO",
  "camera": {
    "target": [0.0, 1.5, 0.0],
    "distance": 9.5,
