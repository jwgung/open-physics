  "manipulation": {
    "grab_radius": 72.0,
    "objects": [
      { "id": "handle", "surface": "press", "snap": 0.02, "height": false },
      { "id": "load", "surface": "beam_top", "snap": 0.25, "height": false, "drag": false },
      { "id": "fulcrum", "surface": "floor_line", "snap": 0.25, "height": false, "drag": false }
