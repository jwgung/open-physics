{
  "id": "incline-friction",
  "version": 1,
  "content": "incline-friction",
  "scene": "res://experiments/incline_friction/incline_friction.gd",
  "bench_id": "S3",
  "camera": {
    "target": [0.8, 2.8, 0.0],
    "distance": 8.5,
    "distance_range": [3.0, 20.0],
    "yaw_range_deg": [-100.0, 100.0],
    "pitch_range_deg": [-89.0, -2.0],
    "pan_radius": 5.0,
    "default_mode": "front",
    "views": {
      "front": { "yaw_deg": 0.0, "pitch_deg": -6.0, "distance": 9.5 },
      "three_quarter": { "yaw_deg": 35.0, "pitch_deg": -24.0 },
      "top": { "yaw_deg": 0.0, "pitch_deg": -89.0 },
      "side": { "yaw_deg": 90.0, "pitch_deg": -10.0, "distance": 12.0 },
      "follow": { "yaw_deg": 20.0, "pitch_deg": -18.0, "distance": 4.0 }
    }
  },
  "controls": [
    {
      "id": "angle", "type": "slider", "label": "빗면 각도", "unit": "°",
      "min": 0.0, "max": 45.0, "step": 0.5, "default": 20.0, "digits": 1
    },
    {
      "id": "material", "type": "choice", "label": "표면 재질", "default": "wood",
      "note": "상자와 빗면이 같은 재질이에요.",
      "options": [
        { "id": "steel", "label": "강철", "mu_s": 0.26, "mu_k": 0.08 },
        { "id": "wood", "label": "나무", "mu_s": 0.40, "mu_k": 0.22 },
        { "id": "rubber", "label": "고무", "mu_s": 0.60, "mu_k": 0.42 },
        { "id": "clay", "label": "점토", "mu_s": 0.76, "mu_k": 0.58 }
      ]
    }
  ],
  "actions": [
    { "id": "release", "label": "상자 놓기", "style": "primary" },
    { "id": "reset", "label": "처음으로" }
  ],
  "key_observations": ["critical_angle", "state", "acceleration"],
  "observations": [
    { "id": "critical_angle", "label": "임계각 θc (tan θc = μs)", "unit": "°", "digits": 1 },
    { "id": "state", "label": "상자 상태" },
    { "id": "tangential", "label": "중력의 빗면 성분 mg sinθ", "unit": "N", "digits": 2 },
    { "id": "max_static", "label": "최대 정지 마찰력 μs·mg cosθ", "unit": "N", "digits": 2 },
    { "id": "acceleration", "label": "가속도 a", "unit": "m/s²", "digits": 2 },
    { "id": "distance", "label": "이동 거리 (시뮬레이션)", "unit": "m", "digits": 2 },
    { "id": "run", "label": "출발점에서 빗면 끝까지", "unit": "m", "digits": 1 }
  ],
  "manipulation": {
    "objects": [
      { "id": "box", "surface": "incline", "snap": 0.5, "height": false }
    ],
    "demo_action": "release"
  },
  "graph": {
    "title": "놓은 뒤 이동 거리",
    "x": { "label": "시간 t", "unit": "s", "max": 3.0 },
    "y": { "label": "이동 거리 s", "unit": "m", "min_max": 1.0 },
    "series": [
      { "id": "formula", "label": "공식 ½at²", "color": "#2d7cf6", "style": "line" },
      { "id": "measured", "label": "시뮬레이션", "color": "#ff3b3b", "style": "points" }
    ]
  }
}
