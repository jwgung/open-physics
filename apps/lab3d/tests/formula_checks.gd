## Headless checks of the formula correction layer (Phase 1 Task 3), run by run_tests.gd.
## 1. parity: every PhysicsLaws port used by the 10 guided mechanics experiments against the TS-core
##    vectors (tests/formula_vectors.json, generated by tools/formula-vectors.test.ts), relative
##    error <= the file's tolerance (1e-9; |e| < 1 uses the absolute error).
## 2. representative scenes (one per correction method, real Jolt bodies): the key motion matches
##    the TS targets in the same file ("scenes") within the tolerances in docs/formula-correction.md.
extends RefCounted

const VECTORS_PATH := "res://tests/formula_vectors.json"
const STEP_HZ := 60

var tree: SceneTree
var expect: Callable   # (ok: bool, label: String, detail: String)
var vectors: Dictionary
var _arg_types := {}   # PhysicsLaws function -> argument Variant types (JSON numbers are floats)


func _init(scene_tree: SceneTree, expect_fn: Callable) -> void:
	tree = scene_tree
	expect = expect_fn
	vectors = JSON.parse_string(FileAccess.get_file_as_string(VECTORS_PATH))
	for method in (PhysicsLaws as Script).get_script_method_list():
		_arg_types[method.name] = method.args.map(func(arg: Dictionary) -> int: return arg.type)


func run() -> void:
	check_parity()
	check_layer_contract()
	await check_uniform_field()
	await check_contact_force()
	await check_collision()
	await check_spring()
	await check_orbit()
	await check_buoyancy()
	await check_kinematic_models()


# --- 1. parity --------------------------------------------------------------------------------

func check_parity() -> void:
	var tolerance: float = vectors.tolerance
	var laws: Dictionary = vectors.experiments
	expect.call(laws.size() == 10, "formula vectors cover the 10 guided mechanics experiments", ", ".join(laws.keys()))
	var missing: Array[String] = []
	for lab in laws:
		for law in laws[lab]:
			if not _arg_types.has(law):
				missing.append(law)
	expect.call(missing.is_empty(), "every law in the vectors has a PhysicsLaws port", ", ".join(missing))
	var per_lab := {}
	for case in vectors.cases:
		var lab: String = case.experiment
		if not per_lab.has(lab):
			per_lab[lab] = {"count": 0, "worst": 0.0, "failed": []}
		var entry: Dictionary = per_lab[lab]
		entry.count += 1
		if not _arg_types.has(case.law):
			continue
		var actual: Variant = (PhysicsLaws as Script).callv(case.law, _typed_args(case.law, case.args))
		var error := _error(actual, case.expect)
		if error < 0.0 or error > tolerance:
			if entry.failed.size() < 3:
				entry.failed.append("%s%s -> %s (want %s)" % [case.law, str(case.args), str(actual), str(case.expect)])
			error = INF if error < 0.0 else error
		entry.worst = maxf(entry.worst, error)
	for lab in laws:
		var entry: Dictionary = per_lab.get(lab, {"count": 0, "worst": INF, "failed": ["no cases"]})
		expect.call(entry.count > 0 and entry.worst <= tolerance, "%s laws parity (%s)" % [lab, ", ".join(laws[lab])],
			"%d cases, max rel err %s %s" % [entry.count, str(entry.worst), "; ".join(entry.failed)])


func _typed_args(law: String, args: Array) -> Array:
	var types: Array = _arg_types[law]
	var typed := []
	for i in args.size():
		typed.append(int(args[i]) if i < types.size() and types[i] == TYPE_INT else args[i])
	return typed


## Relative error (absolute when |expected| < 1) of a value against the JSON expectation; -1 when
## the shapes or exact values (bool, string) differ.
func _error(actual: Variant, expected: Variant) -> float:
	match typeof(expected):
		TYPE_FLOAT, TYPE_INT:
			if typeof(actual) != TYPE_FLOAT and typeof(actual) != TYPE_INT:
				return -1.0
			return absf(float(actual) - float(expected)) / maxf(1.0, absf(float(expected)))
		TYPE_BOOL, TYPE_STRING:
			return 0.0 if typeof(actual) == typeof(expected) and actual == expected else -1.0
		TYPE_ARRAY:
			if not (actual is Array or actual is PackedFloat64Array) or actual.size() != expected.size():
				return -1.0
			var worst := 0.0
			for i in expected.size():
				var error := _error(actual[i], expected[i])
				if error < 0.0:
					return -1.0
				worst = maxf(worst, error)
			return worst
		TYPE_DICTIONARY:
			if not actual is Dictionary:
				return -1.0
			var worst := 0.0
			for key in expected:
				if not actual.has(key):
					return -1.0
				var error := _error(actual[key], expected[key])
				if error < 0.0:
					return -1.0
				worst = maxf(worst, error)
			return worst
	return -1.0


## The shared parts of the base class: method ids, the leapfrog start factor, record().
func check_layer_contract() -> void:
	var ids := []
	for corrector: FormulaCorrector in [ContactFrictionCorrector.new(), UniformFieldCorrector.new(), CollisionCorrector.new(),
			SpringInjector.new(), BuoyancyInjector.new(), PointGravityInjector.new(), PendulumModelDriver.new(),
			LeverModelDriver.new(), PulleyModelDriver.new()]:
		if not ids.has(corrector.method):
			ids.append(corrector.method)
	ids.sort()
	var methods := FormulaCorrector.METHODS.duplicate()
	methods.sort()
	expect.call(ids == methods, "formula layer: every corrector's method id is one of METHODS (all 5 used)", str(ids))
	var base := FormulaCorrector.new()
	var factors := [base.start_factor(true), base.start_factor(false)]
	base.leapfrog_start = false
	factors.append(base.start_factor(true))
	expect.call(factors == [0.5, 1.0, 1.0], "formula layer: start_factor = 1/2 only on the first step with leapfrog_start", str(factors))
	base.history_steps = 3
	base.record(1.0)
	base.record(2.0, -3.0)
	base.record(4.0)
	base.record(6.0, 5.0)
	var v := base.velocities
	expect.call(base.samples == PackedFloat64Array([1.0, 2.0, 4.0]) and v.size() == 3 and is_nan(v[0]) and v[1] == -3.0 and is_nan(v[2])
		and base.last_sample == 6.0 and base.last_velocity == 5.0,
		"formula layer: record() keeps bounded samples and index-aligned velocities (NAN without one)", "%s / %s" % [base.samples, v])
	base.record(7.0)
	expect.call(is_nan(base.last_velocity), "formula layer: last_velocity belongs to the last sample (NAN without one)", str(base.last_velocity))
	var incline := InclineFrictionCorrector.new()
	var pivot := Node3D.new()
	incline.incline = pivot
	var aliased := incline.surface == pivot
	var other := Node3D.new()
	incline.surface = other
	expect.call(aliased and incline.incline == other, "formula layer: InclineFrictionCorrector.incline is another name for surface (both ways)", "")
	pivot.free()
	other.free()


# --- 2. representative scenes -------------------------------------------------------------------

func _world() -> Node3D:
	var world := Node3D.new()
	tree.root.add_child(world)
	return world


func _floor(world: Node3D, top: float) -> StaticBody3D:
	var floor_body := StaticBody3D.new()
	var material := PhysicsMaterial.new()
	material.friction = 0.0
	floor_body.physics_material_override = material
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(40.0, 1.0, 40.0)
	shape.shape = box
	floor_body.add_child(shape)
	floor_body.position = Vector3(0.0, top - 0.5, 0.0)
	world.add_child(floor_body)
	return floor_body


## A rigid body (FormulaBody when `formula`) with a sphere (size.x = radius) or box shape.
func _body(world: Node3D, mass: float, position: Vector3, sphere_radius := 0.0, box_size := 0.0, formula := true) -> RigidBody3D:
	var body: RigidBody3D = FormulaBody.new() if formula else RigidBody3D.new()
	body.mass = mass
	body.can_sleep = false
	body.linear_damp_mode = RigidBody3D.DAMP_MODE_REPLACE
	body.angular_damp_mode = RigidBody3D.DAMP_MODE_REPLACE
	var material := PhysicsMaterial.new()
	material.friction = 0.0
	material.bounce = 0.0
	body.physics_material_override = material
	var shape := CollisionShape3D.new()
	if sphere_radius > 0.0:
		var sphere := SphereShape3D.new()
		sphere.radius = sphere_radius
		shape.shape = sphere
	else:
		var box := BoxShape3D.new()
		box.size = Vector3.ONE * box_size
		shape.shape = box
	body.add_child(shape)
	body.position = position
	world.add_child(body)
	return body


func _steps(count: int) -> void:
	for i in count:
		await tree.physics_frame


func _rel(value: float, expected: float) -> float:
	return absf(value - expected) / maxf(1e-12, absf(expected))


## Time (s) at which an increasing series crosses `level`, linearly interpolated between steps.
static func _crossings(series: PackedFloat64Array, level: float, rising: bool) -> PackedFloat64Array:
	var times := PackedFloat64Array()
	for k in range(1, series.size()):
		var a := series[k - 1] - level
		var b := series[k] - level
		if (rising and a < 0.0 and b >= 0.0) or (not rising and a > 0.0 and b <= 0.0):
			times.append((k - 1 + a / (a - b)) / float(STEP_HZ))
	return times


## uniform_field: three masses dropped together and one projectile; positions at the step points
## equal x0 + v0 t + g t^2 / 2 (TS constantAccelerationDisplacement), independent of mass.
func check_uniform_field() -> void:
	var target: Dictionary = vectors.scenes.uniform_field
	var g: float = target.g
	var world := _world()
	_floor(world, 0.0)
	var drops: Array[RigidBody3D] = []
	var x := 0.0
	for mass in target.masses:
		var drop := _body(world, mass, Vector3(x, 8.0, 0.0), 0.25)
		drop.contact_monitor = true
		drop.max_contacts_reported = 4
		drop.corrector = UniformFieldCorrector.new()
		drop.freeze = true
		drops.append(drop)
		x += 1.5
	var thrown := _body(world, 1.0, Vector3(-8.0, 0.3, 4.0), 0.25)
	thrown.corrector = UniformFieldCorrector.new()
	thrown.contact_monitor = true
	thrown.max_contacts_reported = 4
	thrown.freeze = true
	await tree.physics_frame
	var v0 := Vector3(target.v0[0], target.v0[1], 0.0)
	for drop in drops:
		drop.corrector.release(drop, Vector3.ZERO)
	thrown.corrector.release(thrown, v0)
	await _steps(100)
	var worst_drop := 0.0
	var worst_mass := 0.0
	for k in [15, 30, 45, 60]:
		var t: float = k / float(STEP_HZ)
		var expected := PhysicsLaws.constant_acceleration_displacement(0.0, -g, t)
		for drop in drops:
			worst_drop = maxf(worst_drop, absf(drop.corrector.samples[k] - expected))
			worst_mass = maxf(worst_mass, absf(drop.corrector.samples[k] - drops[0].corrector.samples[k]))
	expect.call(worst_drop <= 1e-4, "uniform field: free fall s(t) = g t^2 / 2 at the step points (3 masses)", "max |diff| %s m" % String.num_scientific(worst_drop))
	expect.call(worst_mass <= 1e-6, "uniform field: the masses fall together", "max spread %s m" % String.num_scientific(worst_mass))
	var worst_throw := 0.0
	for row in target.samples:
		var k := roundi(float(row.t) * STEP_HZ)
		var offset: Vector3 = thrown.corrector.offsets[k]
		worst_throw = maxf(worst_throw, maxf(absf(offset.x - float(row.x)), absf(offset.y - float(row.y))))
	expect.call(worst_throw <= 1e-4, "uniform field: projectile (x, y)(t) = TS constantAccelerationDisplacement", "max |diff| %s m" % String.num_scientific(worst_throw))
	var land_time := sqrt(2.0 * (8.0 - 0.25) / g)
	var landed: int = drops[1].corrector.landed_step
	expect.call(landed > 0 and absf(landed / float(STEP_HZ) - land_time) <= 2.0 / STEP_HZ, "uniform field: free flight ends at the floor contact (formula time ±2 steps)",
		"contact at step %d (%.3f s), formula %.3f s" % [landed, landed / float(STEP_HZ), land_time])
	var shown: Dictionary = thrown.corrector.formula_values()
	expect.call(float(shown.y) == PhysicsLaws.constant_acceleration_displacement(float(target.v0[1]), -g, float(shown.time)),
		"uniform field: displayed height comes from the formula", "t %.3f s, y %.4f m" % [shown.time, shown.y])
	world.queue_free()
	await tree.process_frame
	await _check_throw_from_floor(target)
	await _check_moon_field()
	await _check_throw_off_table_edge()
	await _check_contact_monitor_off(target)


## A ball resting on the floor (touching it when released) and thrown up does not land at release:
## the flight lasts 2 v0y / g and the formula time keeps running until then.
func _check_throw_from_floor(target: Dictionary) -> void:
	var g: float = target.g
	var world := _world()
	_floor(world, 0.0)
	var ball := _body(world, 1.0, Vector3(0.0, 0.25, 0.0), 0.25)
	ball.contact_monitor = true
	ball.max_contacts_reported = 4
	await _steps(10)   # settle on the floor, in contact
	var resting := ball.get_contact_count()
	var corrector := UniformFieldCorrector.new()
	corrector.g = g
	ball.corrector = corrector
	var v0 := Vector3(target.v0[0], target.v0[1], 0.0)
	corrector.release(ball, v0)
	await _steps(30)
	var midair := corrector.time()
	await _steps(STEP_HZ)
	var flight := 2.0 * v0.y / g
	var landed := corrector.landed_step
	expect.call(resting > 0 and midair > 0.4 and landed > 0 and absf(landed / float(STEP_HZ) - flight) <= 2.0 / STEP_HZ,
		"uniform field: a throw from the floor lands after 2 v0y / g, not at release (±2 steps)",
		"contacts at release %d, time at 0.5 s %.3f s, landed step %d (%.3f s), formula %.3f s" % [resting, midair, landed, landed / float(STEP_HZ), flight])
	world.queue_free()
	await tree.process_frame


## The formulas use the field the engine applies (here an Area3D with moon gravity 1.62 m/s^2 along a
## tilted direction), not the default 9.81 down: displayed values = engine motion.
func _check_moon_field() -> void:
	var world := _world()
	var area := Area3D.new()
	area.gravity_space_override = Area3D.SPACE_OVERRIDE_REPLACE
	area.gravity = 1.62
	var direction := Vector3(1.0, -2.0, 0.0).normalized()
	area.gravity_direction = direction
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3.ONE * 60.0
	shape.shape = box
	area.add_child(shape)
	world.add_child(area)
	var ball := _body(world, 1.0, Vector3(0.0, 10.0, 0.0), 0.25)
	ball.freeze = true
	var corrector := UniformFieldCorrector.new()
	ball.corrector = corrector
	await _steps(3)   # the area registers the body
	var v0 := Vector3(1.0, 2.0, 0.0)
	corrector.release(ball, v0)
	await _steps(STEP_HZ + 1)
	var shown := corrector.formula_values()
	var offset: Vector3 = corrector.offsets[-1]
	var t := float(shown.time)
	var want_y := PhysicsLaws.constant_acceleration_displacement(v0.y, float(direction.y) * 1.62, t)
	var error := maxf(absf(float(shown.x) - offset.x), maxf(absf(float(shown.y) - offset.y), absf(float(shown.z) - offset.z)))
	expect.call(absf(corrector.g - 1.62) <= 1e-6 and corrector.field_direction.is_equal_approx(direction) and absf(float(shown.y) - want_y) <= 1e-6 and error <= 1e-4,
		"uniform field: formulas use the engine field (moon 1.62 m/s^2, tilted) and match the engine motion",
		"g %.6f, direction %s, t %.3f s, shown (%.4f, %.4f) vs engine (%.4f, %.4f), max |diff| %s m" % [corrector.g, corrector.field_direction, t,
			shown.x, shown.y, offset.x, offset.y, String.num_scientific(error)])
	world.queue_free()
	await tree.process_frame


## A ball pushed off a table edge with a downward velocity component does not land on the table it
## starts on: the flight ends on the floor 1 m below.
func _check_throw_off_table_edge() -> void:
	var world := _world()
	_floor(world, 0.0)
	var table := StaticBody3D.new()
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(2.0, 1.0, 2.0)
	shape.shape = box
	table.add_child(shape)
	table.position = Vector3(-1.0, 0.5, 0.0)   # top at y = 1, edge at x = 0
	world.add_child(table)
	var ball := _body(world, 1.0, Vector3(-0.05, 1.25, 0.0), 0.25)
	ball.contact_monitor = true
	ball.max_contacts_reported = 4
	await _steps(10)   # settle on the table, in contact
	var resting := ball.get_contact_count()
	var corrector := UniformFieldCorrector.new()
	ball.corrector = corrector
	corrector.release(ball, Vector3(3.0, -1.0, 0.0))
	await _steps(STEP_HZ + 30)
	var landed := corrector.landed_step
	var drop: float = corrector.offsets[landed].y if landed >= 0 else 0.0
	expect.call(resting > 0 and landed > 2 and absf(drop + 1.0) <= 0.1,
		"uniform field: thrown off a table edge with v0 (3, -1) lands on the floor, not on the table at release",
		"contacts at release %d, landed step %d, drop %.3f m" % [resting, landed, drop])
	world.queue_free()
	await tree.process_frame


## release() turns the contact monitor on when it is off: a drop still lands on the floor, and a throw
## from the floor (the first contact report seeds the release surfaces) does not land at release.
func _check_contact_monitor_off(target: Dictionary) -> void:
	var g: float = target.g
	var world := _world()
	_floor(world, 0.0)
	var drop := _body(world, 1.0, Vector3(0.0, 3.0, 0.0), 0.25)
	drop.freeze = true
	var thrown := _body(world, 1.0, Vector3(3.0, 0.25, 0.0), 0.25)
	await _steps(10)   # the thrown ball rests on the floor
	var drop_corrector := UniformFieldCorrector.new()
	drop.corrector = drop_corrector
	var throw_corrector := UniformFieldCorrector.new()
	thrown.corrector = throw_corrector
	drop_corrector.release(drop, Vector3.ZERO)
	throw_corrector.release(thrown, Vector3(0.0, 4.0, 0.0))
	await _steps(STEP_HZ + 10)
	var drop_time := sqrt(2.0 * (3.0 - 0.25) / g)
	var flight := 2.0 * 4.0 / g
	var dropped := drop_corrector.landed_step / float(STEP_HZ)
	var landed := throw_corrector.landed_step / float(STEP_HZ)
	expect.call(drop.contact_monitor and drop.max_contacts_reported > 0 and drop_corrector.landed_step > 0 and absf(dropped - drop_time) <= 2.0 / STEP_HZ
		and throw_corrector.landed_step > 0 and absf(landed - flight) <= 2.0 / STEP_HZ,
		"uniform field: release() turns contact_monitor on (drop lands ±2 steps, throw from the floor not at release)",
		"monitor %s, drop %.3f s vs %.3f s, throw %.3f s vs %.3f s" % [drop.contact_monitor, dropped, drop_time, landed, flight])
	world.queue_free()
	await tree.process_frame


## contact_force (floor push, PushFrictionLaw): below the maximum static friction the box holds;
## above it s(t) = a t^2 / 2 with a = (F - mu_k m g) / m.
func check_contact_force() -> void:
	var target: Dictionary = vectors.scenes.contact_force
	var world := _world()
	_floor(world, 0.0)
	var surface := Node3D.new()
	world.add_child(surface)
	var box := _body(world, target.mass, Vector3(0.0, 0.2, 0.0), 0.0, 0.4)
	var corrector := ContactFrictionCorrector.new()
	corrector.law = "push"
	corrector.surface = surface
	corrector.tangent_axis = Vector3.RIGHT
	corrector.half_length = 15.0
	corrector.half_extent = 0.2
	corrector.mu_s = target.mu_s
	corrector.mu_k = target.mu_k
	box.corrector = corrector
	await _steps(10)   # settle on the floor
	for force in [target.hold_force, target.push_force]:
		box.linear_velocity = Vector3.ZERO
		corrector.reset(box.global_position)
		corrector.applied_force = force
		await _steps(2 * STEP_HZ + 2)
		if force == target.hold_force:
			expect.call(corrector.max_offset <= 0.001 and corrector.status == "holding", "contact force: %.0f N < max static %.2f N holds 2 s" % [force, target.max_static],
				"moved %.4f mm, %s" % [corrector.max_offset * 1000.0, corrector.status])
	var worst := 0.0
	for row in target.samples:
		worst = maxf(worst, _rel(corrector.samples[roundi(float(row.t) * STEP_HZ)], row.s))
	expect.call(worst <= 1e-4, "contact force: %.0f N push follows s = a t^2 / 2 (a = %.4f m/s^2)" % [target.push_force, target.accel],
		"s(1 s) %.5f, s(2 s) %.5f m, max rel %s" % [corrector.samples[STEP_HZ], corrector.samples[2 * STEP_HZ], String.num_scientific(worst)])
	world.queue_free()
	await tree.process_frame


## collision: spheres (1 kg, r 0.6 and 2 kg, r 0.8) leave with the TS world outcome, whatever their
## Jolt materials (bounce 0: resolved over two steps; bounce 0.88 each: Jolt e = 1), for a slow touch
## below the 1 m/s threshold (several contact steps), a start in deep overlap, and under gravity
## (velocities = a TS MultiBodyWorld run with gravity). The materials stay the bodies' own.
func check_collision() -> void:
	var target: Dictionary = vectors.scenes.collision
	var head_on: Array = target.velocities
	var cases := [
		["elastic, bounce 0", target.elastic, head_on, 0.0, 6.0, 0.0],
		["rubber, bounce 0", target.rubber, head_on, 0.0, 6.0, 0.0],
		["rubber, bounce 0.88 each", target.rubber, head_on, 0.88, 6.0, 0.0],
		["slow 0.7 m/s, e = 0", target.slow, target.slow.velocities, 0.0, 1.65, 0.0],
		["rubber, deep overlap at the start", target.rubber, head_on, 0.0, 1.35, 0.0],
		["rubber, under gravity", target.gravity, head_on, 0.0, 6.0, 1.0],
	]
	for case in cases:
		var outcome: Dictionary = case[1]
		var velocities: Array = case[2]
		var world := _world()
		var a := _body(world, target.masses[0], Vector3(-0.5 * case[4], 6.0, 0.0), 0.6, 0.0, false)
		var b := _body(world, target.masses[1], Vector3(0.5 * case[4], 6.0, 0.0), 0.8, 0.0, false)
		for body in [a, b]:
			body.gravity_scale = case[5]
			body.physics_material_override.bounce = case[3]
		var corrector := CollisionCorrector.new()
		corrector.setup(a, b, 0.6, 0.8, outcome.e, outcome.e)
		corrector.threshold = target.threshold
		var driver := FormulaDriver.new()
		driver.correctors.append(corrector)
		world.add_child(driver)
		a.linear_velocity = Vector3(velocities[0], 0.0, 0.0)
		b.linear_velocity = Vector3(velocities[1], 0.0, 0.0)
		driver.running = true
		if case[5] > 0.0:
			# Read after the same number of engine steps as the TS run (one per corrector step).
			while corrector.steps < int(outcome.steps):
				await tree.physics_frame
		else:
			await _steps(90)
		var engine: Array = corrector.events[0].engine if corrector.events.size() > 0 else [Vector3.ZERO, Vector3.ZERO]
		var contact_steps: int = corrector.events[0].steps if corrector.events.size() > 0 else 0
		var error := 0.0
		var detail := ""
		if case[5] > 0.0:
			# The TS world target holds both components after the same number of 60 Hz steps.
			var want: Array = outcome.after
			var got := [a.linear_velocity.x, a.linear_velocity.y, b.linear_velocity.x, b.linear_velocity.y]
			for i in 4:
				error = maxf(error, absf(got[i] - float(want[i])))
			detail = "%s vs TS world %s" % [str(got), str(want)]
		else:
			var after := [a.linear_velocity.x, b.linear_velocity.x]
			error = maxf(absf(after[0] - float(outcome.after[0])), absf(after[1] - float(outcome.after[1])))
			var momentum: float = target.masses[0] * after[0] + target.masses[1] * after[1]
			var momentum_before: float = target.masses[0] * float(velocities[0]) + target.masses[1] * float(velocities[1])
			expect.call(absf(momentum - momentum_before) <= 1e-4, "collision (%s): momentum conserved" % case[0], "%.6f vs %.6f kg m/s" % [momentum, momentum_before])
			detail = "%.4f / %.4f m/s vs %.4f / %.4f" % [after[0], after[1], outcome.after[0], outcome.after[1]]
		var shown := corrector.formula_values()
		expect.call(corrector.events.size() == 1 and error <= 1e-4 and absf(float(shown.get("velocity_a", INF)) - float(outcome.after[0])) <= 1e-6,
			"collision (%s, e = %.2f): velocities after = TS world outcome" % [case[0], outcome.e],
			"%s (engine %.4f / %.4f over %d contact step(s)), %d event(s)" % [detail, engine[0].x, engine[1].x, contact_steps, corrector.events.size()])
		world.queue_free()
		await tree.process_frame
	await _check_collision_materials()


## The collision corrector leaves the bodies' materials alone: a ball of a corrected pair bounces
## on the floor exactly like an uncorrected twin with the same material.
func _check_collision_materials() -> void:
	var world := _world()
	_floor(world, 0.0)
	var paired := _body(world, 1.0, Vector3(0.0, 2.0, 0.0), 0.3, 0.0, false)
	var twin := _body(world, 1.0, Vector3(3.0, 2.0, 0.0), 0.3, 0.0, false)
	var partner := _body(world, 1.0, Vector3(-6.0, 2.0, 0.0), 0.3, 0.0, false)
	partner.gravity_scale = 0.0
	for body in [paired, twin, partner]:
		body.physics_material_override.bounce = 0.3
		body.physics_material_override.friction = 0.4
	var material := paired.physics_material_override
	var corrector := CollisionCorrector.new()
	corrector.setup(paired, partner, 0.3, 0.3, 0.88, 0.88)
	var driver := FormulaDriver.new()
	driver.correctors.append(corrector)
	world.add_child(driver)
	driver.running = true
	var worst := 0.0
	var rebound := 0.0
	for i in 90:
		await tree.physics_frame
		worst = maxf(worst, (paired.linear_velocity - twin.linear_velocity).length())
		rebound = maxf(rebound, paired.linear_velocity.y)
	expect.call(paired.physics_material_override == material and is_equal_approx(material.bounce, 0.3) and is_equal_approx(material.friction, 0.4)
		and is_equal_approx(partner.physics_material_override.bounce, 0.3), "collision: setup() keeps the bodies' own materials", "bounce %.2f, friction %.2f" % [material.bounce, material.friction])
	expect.call(worst <= 1e-5 and rebound > 1.0 and corrector.events.is_empty(), "collision: floor bounce of a corrected body = its own material (uncorrected twin)",
		"max |dv| %s m/s, rebound %.3f m/s, %d event(s)" % [String.num_scientific(worst), rebound, corrector.events.size()])
	world.queue_free()
	await tree.process_frame


## spring (force injection): period and energy of an undamped 1 kg, k = 5 N/m oscillator.
func check_spring() -> void:
	var target: Dictionary = vectors.scenes.force_injection.spring
	var world := _world()
	var ball := _body(world, target.mass, Vector3(1.0 + float(target.amplitude), 5.0, 0.0), 0.2)
	ball.gravity_scale = 0.0
	ball.collision_layer = 0
	ball.collision_mask = 0
	var spring := SpringInjector.new()
	spring.anchor = Vector3(0.0, 5.0, 0.0)
	spring.rest_length = 1.0
	spring.stiffness = target.stiffness
	spring.history_steps = 10 * STEP_HZ
	spring.reset(ball)
	ball.corrector = spring
	var worst_energy := 0.0
	for i in 10 * STEP_HZ:
		await tree.physics_frame
		if i > 0:
			worst_energy = maxf(worst_energy, _rel(spring.engine_energy(ball), target.energy))
	var crossings := _crossings(spring.samples, 0.0, true)
	var period := (crossings[-1] - crossings[0]) / (crossings.size() - 1) if crossings.size() >= 2 else 0.0
	expect.call(_rel(period, target.period) <= 1e-3, "force injection (spring): period = 2 pi sqrt(m / k) ±0.1%",
		"%.5f s vs %.5f s over %d periods" % [period, target.period, crossings.size() - 1])
	expect.call(worst_energy <= 5e-3, "force injection (spring): engine energy stays at k A^2 / 2 ±0.5% over 10 s",
		"max rel dev %s (E = %.4f J)" % [String.num_scientific(worst_energy), target.energy])
	var shown := spring.formula_values()
	expect.call(float(shown.total_energy) == float(target.energy) and absf(float(shown.spring_energy) + float(shown.kinetic_energy) - float(target.energy)) <= 1e-12,
		"force injection (spring): displayed energies come from the formula", str(shown))
	world.queue_free()
	await tree.process_frame
	await _check_damped_spring(target)
	await _check_spring_launch(target)


## Damped spring (b = 0.45 kg/s, the web preset): the displayed energies are those of the current
## state (TS kineticEnergy m v^2 / 2 + springEnergy k x^2 / 2), so the total falls as the motion decays
## (dE/dt = -b v^2 <= 0) and kinetic = m v^2 / 2 of the step-synchronised engine speed.
func _check_damped_spring(target: Dictionary) -> void:
	var world := _world()
	var ball := _body(world, target.mass, Vector3(1.0 + float(target.amplitude), 5.0, 0.0), 0.2)
	ball.gravity_scale = 0.0
	ball.collision_layer = 0
	ball.collision_mask = 0
	var spring := SpringInjector.new()
	spring.anchor = Vector3(0.0, 5.0, 0.0)
	spring.rest_length = 1.0
	spring.stiffness = target.stiffness
	spring.damping = 0.45
	spring.reset(ball)
	ball.corrector = spring
	var first := spring.formula_values()
	var worst_sum := 0.0
	var worst_rise := 0.0
	var worst_kinetic := 0.0
	var previous := INF
	for i in 5 * STEP_HZ:
		var speed := spring.synced_velocity(ball).length()   # state the next sample sees
		await tree.physics_frame
		if spring.steps < 2:
			continue
		var shown := spring.formula_values()
		var total: float = shown.total_energy
		worst_sum = maxf(worst_sum, absf(total - float(shown.kinetic_energy) - float(shown.spring_energy)))
		worst_rise = maxf(worst_rise, total - previous)
		worst_kinetic = maxf(worst_kinetic, absf(float(shown.kinetic_energy) - PhysicsLaws.kinetic_energy(target.mass, speed)))
		previous = total
	var last := spring.formula_values()
	var start := PhysicsLaws.spring_potential_energy(target.stiffness, target.amplitude)
	expect.call(float(first.total_energy) == start and worst_sum <= 1e-12 and worst_kinetic <= 1e-6,
		"force injection (spring, damped): displayed energies = kinetic m v^2 / 2 + spring k x^2 / 2 of the current state",
		"start %.4f J, |K + U - E| %s, |K - m v^2 / 2| %s" % [first.total_energy, String.num_scientific(worst_sum), String.num_scientific(worst_kinetic)])
	expect.call(worst_rise <= 1e-6 and float(last.total_energy) < 0.5 * start,
		"force injection (spring, damped): the displayed total energy only falls", "after 5 s %.4f J of %.4f J, max rise %s J" % [last.total_energy, start, String.num_scientific(worst_rise)])
	world.queue_free()
	await tree.process_frame


## Undamped spring launched at 2 m/s from its rest length: the displayed total is the release state's
## K + U = m v0^2 / 2 (the extension is 0 there), not k A^2 / 2 of the release extension alone, and
## the engine energy stays at it (K = E - U is clamped at 0, so K + U exceeds E by the measured x overshoot only).
func _check_spring_launch(target: Dictionary) -> void:
	var world := _world()
	var ball := _body(world, target.mass, Vector3(1.0, 5.0, 0.0), 0.2)
	ball.gravity_scale = 0.0
	ball.collision_layer = 0
	ball.collision_mask = 0
	ball.linear_velocity = Vector3(2.0, 0.0, 0.0)
	var spring := SpringInjector.new()
	spring.anchor = Vector3(0.0, 5.0, 0.0)
	spring.rest_length = 1.0
	spring.stiffness = target.stiffness
	spring.reset(ball)
	ball.corrector = spring
	var expected := PhysicsLaws.kinetic_energy(target.mass, 2.0)
	var first := spring.formula_values()
	var worst_engine := 0.0
	var worst_sum := 0.0
	for i in 3 * STEP_HZ:
		await tree.physics_frame
		if i > 0:
			worst_engine = maxf(worst_engine, _rel(spring.engine_energy(ball), expected))
		var shown := spring.formula_values()
		worst_sum = maxf(worst_sum, absf(float(shown.kinetic_energy) + float(shown.spring_energy) - expected))
	expect.call(float(first.total_energy) == expected and float(first.kinetic_energy) == expected and worst_sum <= 5e-3 * expected and worst_engine <= 5e-3,
		"force injection (spring): launched from rest length at 2 m/s, total = m v0^2 / 2 of the release state",
		"total %.4f J (want %.4f), |K + U - E| %s, engine max rel dev %s" % [first.total_energy, expected, String.num_scientific(worst_sum), String.num_scientific(worst_engine)])
	world.queue_free()
	await tree.process_frame


## orbit (force injection): a circular launch keeps its radius and closes one revolution in
## T = 2 pi sqrt(r^3 / G M).
func check_orbit() -> void:
	var target: Dictionary = vectors.scenes.force_injection.orbit
	var world := _world()
	var radius: float = target.radius
	var star := _body(world, 1.0, Vector3(radius, 2.0, 0.0), 0.2)
	star.gravity_scale = 0.0
	star.collision_layer = 0
	star.collision_mask = 0
	var gravity := PointGravityInjector.new()
	gravity.center = Vector3(0.0, 2.0, 0.0)
	gravity.mu = target.mu
	gravity.history_steps = 0
	star.linear_velocity = Vector3(0.0, 0.0, -float(target.speed))
	gravity.reset(star)
	var before_step := gravity.formula_values()
	var start_radius: float = before_step.get("radius", 0.0)
	expect.call(gravity.steps == 0 and _rel(start_radius, radius) <= 1e-6 and before_step.get("circular_speed") == PhysicsLaws.circular_orbit_speed(target.mu, start_radius, 1.0),
		"force injection (orbit): formula values right after reset use the body's radius", str(before_step))
	var at_center := PointGravityInjector.new()
	at_center.center = star.global_position
	at_center.reset(star)
	expect.call(at_center.formula_values() == {"radius": 0.0}, "force injection (orbit): a body at the centre gives only r = 0", str(at_center.formula_values()))
	star.corrector = gravity
	var worst_radius := 0.0
	var period := 0.0
	var last := [0.0, 0.0]   # (time, swept angle) of the previous sample
	for i in int(1.2 * float(target.period) * STEP_HZ):
		await tree.physics_frame
		if gravity.steps == 0:
			continue
		worst_radius = maxf(worst_radius, _rel(gravity.last_sample, radius))
		var t := (gravity.steps - 1) / float(STEP_HZ)   # the sample is the state after steps - 1 steps
		var angle := absf(gravity.swept_angle)
		if period == 0.0 and last[1] < TAU and angle >= TAU:
			period = last[0] + (t - last[0]) * (TAU - last[1]) / (angle - last[1])
		last = [t, angle]
	expect.call(_rel(period, target.period) <= 1e-3, "force injection (orbit): circular period ±0.1%", "%.4f s vs %.4f s" % [period, target.period])
	expect.call(worst_radius <= 1e-3, "force injection (orbit): radius stays within 0.1%", "max rel dev %s" % String.num_scientific(worst_radius))
	world.queue_free()
	await tree.process_frame


## buoyancy (force injection): a 0.4 m box floats at the depth fraction m / m_displaced; a box
## heavier than the displaced water sinks to the bottom.
func check_buoyancy() -> void:
	var target: Dictionary = vectors.scenes.force_injection.buoyancy
	var size: float = target.size
	var world := _world()
	_floor(world, -3.0)
	var boxes := {}
	var x := 0.0
	for kind in ["light", "heavy"]:
		var box := _body(world, target[kind].mass, Vector3(x, size * 0.5, 0.0), 0.0, size)
		var buoyancy := BuoyancyInjector.new()
		buoyancy.waterline = 0.0
		buoyancy.height = size
		buoyancy.displaced_mass = target.displaced_mass
		buoyancy.drag = target.drag
		buoyancy.reset(box)
		box.corrector = buoyancy
		boxes[kind] = box
		x += 2.0
	await _steps(15 * STEP_HZ)
	var light: RigidBody3D = boxes.light
	var fraction := (0.0 - (light.global_position.y - size * 0.5)) / size   # measured from the body, not the corrector
	expect.call(_rel(fraction, target.light.fraction) <= 5e-3 and light.linear_velocity.length() < 0.01,
		"force injection (buoyancy): floats at depth fraction rho_obj / rho_fluid ±0.5%",
		"%.4f vs %.4f (speed %.4f m/s)" % [fraction, target.light.fraction, light.linear_velocity.length()])
	var heavy: RigidBody3D = boxes.heavy
	expect.call(float(heavy.corrector.last_sample) == float(target.heavy.fraction) and absf(heavy.global_position.y - (-3.0 + size * 0.5)) <= 0.03
		and heavy.corrector.formula_values().sinks, "force injection (buoyancy): heavier than the displaced water sinks to the bottom",
		"fraction %.3f, y %.3f" % [heavy.corrector.last_sample, heavy.global_position.y])
	var states := []
	var judge := BuoyancyInjector.new()
	judge.displaced_mass = target.displaced_mass
	for mass in [target.light.mass, target.displaced_mass, target.displaced_mass * (1.0 + 1e-6), target.heavy.mass]:
		judge.mass = mass
		var shown := judge.formula_values()
		states.append("%s/%s" % [shown.buoyancy_state, shown.sinks])
	expect.call(states == ["floats/false", "neutral/false", "sinks/true", "sinks/true"],
		"force injection (buoyancy): floats / neutral (rho_obj = rho_fluid) / sinks judgement", str(states))
	world.queue_free()
	await tree.process_frame


## kinematic_model: the pendulum bob follows the TS PendulumModel step by step with a fixed length
## and still pushes a dynamic ball; the pulley load and lever beam take their formula poses.
func check_kinematic_models() -> void:
	var target: Dictionary = vectors.scenes.kinematic_model
	var world := _world()
	var bob := _body(world, 1.0, Vector3.ZERO, 0.15, 0.0, false)
	var pendulum := PendulumModelDriver.new()
	pendulum.anchor = Vector3(0.0, 5.0, 0.0)
	pendulum.length = target.pendulum.length
	pendulum.angle = target.pendulum.angle
	pendulum.damping = 0.0   # the undamped TS run (period check)
	pendulum.history_steps = 10 * STEP_HZ + 1
	pendulum.attach(bob)
	# Default path: no damping set, so the driver's default must be the TS PendulumModel default.
	var default_bob := _body(world, 1.0, Vector3(-4.0, 0.0, 0.0), 0.15, 0.0, false)
	var default_pendulum := PendulumModelDriver.new()
	default_pendulum.anchor = Vector3(-4.0, 5.0, 0.0)
	default_pendulum.length = target.pendulum.length
	default_pendulum.angle = target.pendulum.angle
	default_pendulum.attach(default_bob)
	var ball := _body(world, 0.5, Vector3(-0.42, 3.0, 0.0), 0.15, 0.0, false)
	ball.gravity_scale = 0.0
	var load := _body(world, 20.0, Vector3(4.0, 0.5, 0.0), 0.0, 0.6, false)
	var pulley := PulleyModelDriver.new()
	pulley.base = load.global_transform
	pulley.strands = 2
	pulley.attach(load)
	var beam := _body(world, 5.0, Vector3(8.0, 1.0, 0.0), 0.0, 0.3, false)
	var lever := LeverModelDriver.new()
	lever.pivot = beam.global_transform
	lever.load_mass = target.lever.load_mass
	lever.load_arm = target.lever.load_arm
	lever.effort_arm = target.lever.effort_arm
	lever.attach(beam)
	var driver := FormulaDriver.new()
	driver.correctors.assign([pendulum, default_pendulum, pulley, lever])
	world.add_child(driver)
	await tree.physics_frame
	driver.running = true
	await _steps(10 * STEP_HZ + 2)
	var worst_angle := 0.0
	var k := 30
	for expected in target.pendulum.angles:
		worst_angle = maxf(worst_angle, absf(pendulum.samples[k] - float(expected)))
		k += 30
	expect.call(worst_angle <= 1e-5, "kinematic model (pendulum): bob angle = TS PendulumModel at 0.5/1/1.5/2 s", "max |diff| %s rad" % String.num_scientific(worst_angle))
	var worst_default := 0.0
	k = 30
	for expected in target.pendulum.default_angles:
		worst_default = maxf(worst_default, absf(default_pendulum.samples[k] - float(expected)))
		k += 30
	expect.call(default_pendulum.damping == float(target.pendulum.default_damping) and worst_default <= 1e-5,
		"kinematic model (pendulum): default damping = TS PendulumModel default, same angles",
		"damping %s vs %s, max |diff| %s rad" % [default_pendulum.damping, target.pendulum.default_damping, String.num_scientific(worst_default)])
	var crossings := _crossings(pendulum.samples, 0.0, false)
	var period := (crossings[-1] - crossings[0]) / (crossings.size() - 1) if crossings.size() >= 2 else 0.0
	expect.call(_rel(period, target.pendulum.period) <= 5e-3, "kinematic model (pendulum): period = 2 pi sqrt(L / g) ±0.5% (0.1 rad swing)",
		"%.4f s vs %.4f s" % [period, target.pendulum.period])
	expect.call(absf(float(pendulum.engine_values().length) - float(target.pendulum.length)) <= 1e-5, "kinematic model (pendulum): the string length stays L",
		"%.6f m" % pendulum.engine_values().length)
	expect.call(ball.linear_velocity.x < -0.05, "kinematic model (pendulum): the posed bob still pushes a dynamic body (Jolt contact)", "ball v %.3f m/s" % ball.linear_velocity.x)
	# Pulley: 1 m of rope lifts the load 1 / n; the force is m g / n for each strand count.
	pulley.pull_distance = 1.0
	await _steps(3)
	var row: Dictionary = target.pulley[1]
	expect.call(absf(pulley.last_sample - float(row.lift_for_pull_1m)) <= 1e-5, "kinematic model (pulley): 1 m pull lifts the load 1 / n (n = 2)", "%.5f m" % pulley.last_sample)
	var forces_ok := true
	for entry in target.pulley:
		pulley.strands = int(entry.strands)
		forces_ok = forces_ok and _rel(float(pulley.formula_values().required_force), float(entry.force)) <= 1e-12
	expect.call(forces_ok, "kinematic model (pulley): displayed force = TS m g / n for 1, 2, 4 strands", str(target.pulley))
	# Lever: below the required force the beam stays level; at it, the beam lifts.
	var required := lever.required_force()
	lever.applied_force = required * 0.9
	await _steps(3)
	var level: float = lever.last_sample
	lever.applied_force = required
	await _steps(3)
	expect.call(_rel(required, target.lever.required) <= 1e-12 and absf(level) <= 1e-6 and absf(lever.last_sample + LeverModelDriver.LIFT_ANGLE) <= 1e-5,
		"kinematic model (lever): level below F = m g r_load / r_effort, lifted at it", "F %.3f N, angles %.5f / %.5f rad" % [required, level, lever.last_sample])
	world.queue_free()
	await tree.process_frame
