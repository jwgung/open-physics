    }
  },
  "controls": [
    {
      "id": "mass", "type": "slider", "label": "짐 질량", "unit": " kg",
      "min": 1.0, "max": 20.0, "step": 1.0, "default": 20.0, "digits": 0
    },
    {
      "id": "effort", "type": "choice", "label": "힘점", "default": "mid",
      "note": "받침점에서 막대 오른쪽 끝까지 거리의 몇 %에서 누를지 골라요.",
      "options": [
        { "id": "near", "label": "가까이", "fraction": 0.35, "note": "받침점–오른쪽 끝의 35 %" },
        { "id": "mid", "label": "중간", "fraction": 0.6, "note": "받침점–오른쪽 끝의 60 %" },
        { "id": "far", "label": "멀리", "fraction": 0.9, "note": "받침점–오른쪽 끝의 90 %" }
      ]
    }
  ],
  "actions": [
    { "id": "reset", "label": "처음으로", "style": "primary" }
