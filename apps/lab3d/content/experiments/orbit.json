{
  "id": "orbit",
  "version": 1,
  "content": "orbit",
  "scene": "res://experiments/orbit/orbit.gd",
  "bench_id": "OR",
  "camera": {
    "target": [0.0, 1.6, 0.0],
    "distance": 12.5,
    "distance_range": [4.0, 30.0],
    "yaw_range_deg": [-100.0, 100.0],
    "pitch_range_deg": [-89.0, -2.0],
    "pan_radius": 7.0,
    "default_mode": "front",
    "views": {
      "front": { "yaw_deg": 0.0, "pitch_deg": -40.0, "distance": 16.0 },
      "three_quarter": { "yaw_deg": 26.0, "pitch_deg": -42.0 },
      "top": { "yaw_deg": 0.0, "pitch_deg": -89.0, "distance": 17.0 },
      "side": { "yaw_deg": 90.0, "pitch_deg": -14.0, "distance": 16.0 },
      "follow": { "yaw_deg": 20.0, "pitch_deg": -30.0, "distance": 7.0 }
    }
  },
  "controls": [
    {
      "id": "speed", "type": "slider", "label": "발사 속력", "unit": " m/s",
      "min": 0.0, "max": 6.0, "step": 0.1, "default": 3.0, "digits": 1
    },
    {
      "id": "direction", "type": "slider", "label": "발사 방향 (90° = 반시계 방향 옆, 0° = 별 바깥쪽)", "unit": "°",
      "min": 0.0, "max": 355.0, "step": 5.0, "default": 90.0, "digits": 0
    },
    {
      "id": "radius", "type": "slider", "label": "출발 반지름 (별 중심에서)", "unit": " m",
      "min": 2.0, "max": 5.0, "step": 0.5, "default": 3.0, "digits": 1
    }
  ],
  "actions": [
    { "id": "launch", "label": "발사", "style": "primary" },
    { "id": "circular", "label": "동그랗게 돌게" },
    { "id": "reset", "label": "처음으로" }
  ],
  "key_observations": ["state", "launch_speed", "escape_speed"],
  "predict": {
    "question": "더 세게 쏘면 별을 떠날까?",
    "choices": [
      { "id": "leave", "label": "떠나요", "picture": "orbit_leave" },
      { "id": "stay", "label": "계속 돌아요", "picture": "orbit_stay" }
    ],
    "answer": "leave",
    "reason": "별은 행성을 끌어당겨요. 아주 빠르게 쏘면 별이 붙잡지 못해서 멀리 떠나요."
  },
  "missions": {
    "observe": "laps",
    "judge_on": ["orbiting"],
    "reveal_on": ["orbiting", "leaving", "crash", "far"],
    "hidden_until_end": ["predicted", "escape_speed"],
    "stages": [
      { "threshold": 1.0, "conditions": {"radius": 4.0}, "text": "별에서 4미터 떨어져 한 바퀴 돌기!" },
      { "threshold": 2.0, "conditions": {"radius": 2.0}, "text": "별 가까이 2미터에서 두 바퀴 돌기!" },
      { "observe": "launch_speed", "threshold": 3.67, "judge_on": ["far"], "conditions": {"radius": 4.0}, "text": "4미터에서 아주 세게 쏴서 별을 떠나기!" }
    ]
  },
  "story": { "clue": "조각 하나가 하늘로 날아갔어! 별 둘레를 돌며 찾아보자.", "map_clue": "마지막은 섬에서 제일 높은 전망대야!" },
  "kid": {
    "card": "state",
    "title": "별 둘레를 빙글빙글 돌아 보자!",
    "place": "별 돌기",
    "say": "별이 행성을 끌어당겨서 빙글빙글 돌게 해요. 가까우면 더 빨리 돌고, 너무 빠르면 별을 떠나요.",
    "tip": "노란 손잡이를 끌어 쏠 방향과 세기를 정해요.",
    "picks": {
      "radius": [
        {"value": 2.0, "label": "2미터", "picture": "orbit", "size": 0.0},
        {"value": 3.0, "label": "3미터", "picture": "orbit", "size": 0.33},
        {"value": 4.0, "label": "4미터", "picture": "orbit", "size": 0.67},
        {"value": 5.0, "label": "5미터", "picture": "orbit", "size": 1.0}
      ]
    },
    "cards": {"state": "행성은?", "launch_speed": "쏘는 빠르기", "escape_speed": "떠나는 빠르기"},
    "states": {"발사 전": "쏘기 전", "별 둘레를 도는 중": "별을 빙글빙글 돌아요", "별에서 멀어지는 중": "별에서 멀어져요"}
  },
  "cast": {
    "dugi": { "at": [8.0, 4.75], "explain_on": ["orbiting", "leaving", "crash", "far"], "delay_s": 1.5 },
    "puppy": { "at": [5.0, -8.75] }
  },
  "observations": [
    { "id": "state", "label": "상태" },
    { "id": "predicted", "label": "예상 결과" },
    { "id": "launch_speed", "label": "발사 속력", "unit": "m/s", "digits": 2 },
    { "id": "circular_speed", "label": "원 궤도 속력 √(GM/r) · 출발 반지름", "unit": "m/s", "digits": 2 },
    { "id": "escape_speed", "label": "탈출 속력 √(2GM/r) · 출발 반지름", "unit": "m/s", "digits": 2 },
    { "id": "radius", "label": "지금 궤도 반지름 r", "unit": "m", "digits": 2 },
    { "id": "period", "label": "원 궤도 예상 주기 2π√(r³/GM)", "unit": "s", "digits": 2 },
    { "id": "speed", "label": "지금 속력", "unit": "m/s", "digits": 2 },
    { "id": "lap", "label": "한 바퀴 걸린 시간", "unit": "s", "digits": 2 },
    { "id": "laps", "label": "별 둘레를 돈 바퀴 수", "unit": "바퀴", "digits": 2 }
  ],
  "manipulation": {
    "grab_radius": 72.0,
    "objects": [
      { "id": "arrow", "surface": "arrow", "snap": 0.1, "height": false },
      { "id": "planet", "surface": "radius_line", "snap": 0.5, "height": false, "drag": false }
    ],
    "demo_action": "launch"
  },
  "graph": {
    "title": "발사 속력과 궤도 기준",
    "x": { "label": "시간 t", "unit": "s", "max": 20.0 },
    "y": { "label": "속력", "unit": "m/s", "min_max": 5.0 },
    "series": [
      { "id": "speed", "label": "지금 속력", "color": "#2d7cf6", "style": "line" },
      { "id": "circular", "label": "원 궤도 속력 (지금 r)", "color": "#1fae4b", "style": "line" },
      { "id": "escape", "label": "탈출 속력 (지금 r)", "color": "#ff3b3b", "style": "line" }
    ]
  }
}
