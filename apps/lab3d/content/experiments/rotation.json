  "key_observations": ["effort_arm", "advantage", "state"],
  "predict": {
    "question": "손잡이를 멀리 잡으면 힘이 덜 들까?",
    "choices": [
      { "id": "less", "label": "덜 들어요", "picture": "lever_far" },
      { "id": "same", "label": "똑같아요", "picture": "lever_same" }
    ],
    "answer": "less",
    "reason": "받침에서 멀리 누를수록 막대가 쉽게 들려요. 그래서 힘이 덜 들어요."
  },
  "missions": {
    "observe": "applied",
    "compare": "less",
    "judge_on": ["lifted"],
    "hidden_until_end": ["required", "advantage", "load_torque", "net_torque"],
    "hidden_series_until_end": ["required"],
    "stages": [
      { "threshold": 350.0, "conditions": {"mass": 20.0, "effort": "near"}, "text": "손잡이를 가까이 잡고 짐 들기!" },
      { "threshold": 200.0, "conditions": {"mass": 20.0, "effort": "mid"}, "text": "손잡이를 중간에 잡고 짐 들기!" },
      { "threshold": 130.0, "conditions": {"mass": 20.0, "effort": "far"}, "text": "손잡이를 멀리 잡고 살살 들기!" }
    ]
  },
  "kid": {
    "card": "state",
    "title": "긴 막대로 무거운 짐을 들어 보자!",
    "place": "시소 들기",
    "say": "받침에서 손잡이를 멀리 잡을수록 힘이 덜 들어요. 그래서 무거운 짐도 살살 들 수 있어요.",
    "tip": "빨간 손잡이를 아래로 눌러 봐요.",
    "picks": {
      "effort": [
        {"value": "near", "label": "가까이", "picture": "lever", "size": 0.0},
